{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm run start",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "regions": ["us-west1"],
    "multiRegionConfig": {
      "us-west1": {
        "numReplicas": 1
      }
    }
  },
  "services": {
    "gid-transfer": {
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm run start",
        "numReplicas": 1,
        "regions": ["us-west1"]
      },
      "networking": {
        "port": 8080,
        "domains": [
          {
            "domain": "gidtransfer.com",
            "type": "custom",
            "port": 8080
          },
          {
            "domain": "gid-transfer-production.up.railway.app",
            "type": "railway",
            "port": 8080
          }
        ]
      },
      "variables": {
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "${{NEXT_PUBLIC_GOOGLE_CLIENT_ID}}",
        "BACKEND_API_URL": "${{BACKEND_API_URL}}",
        "NEXT_PUBLIC_SITE_URL": "${{NEXT_PUBLIC_SITE_URL}}",
        "GOOGLE_SITE_VERIFICATION": "${{GOOGLE_SITE_VERIFICATION}}",
        "NEXT_PUBLIC_STUDIO_BASE_DOMAIN": "${{NEXT_PUBLIC_STUDIO_BASE_DOMAIN}}",
        "NEXT_PUBLIC_STUDIO_SUBDOMAINS": "${{NEXT_PUBLIC_STUDIO_SUBDOMAINS}}",
        "NEXT_PUBLIC_APP_URL": "${{NEXT_PUBLIC_APP_URL}}"
      }
    }
  }
}
